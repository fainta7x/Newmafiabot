# Server configuration
PORT=3000
NODE_ENV=development

# Organizer Authentication
ORGANIZER_PASSWORD=admin
JWT_SECRET=super-secret-jwt-key-change-this-in-production

# SQLite Database path
DATABASE_PATH=./mafia_club.db
SEED_DEMO_DATA=false

# Legacy Telegram Bot Token (Must be revoked in BotFather if previously leaked)
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_URL=
ORGANIZER_CHAT_ID=
# Integration settings
BOT_API_BASE_URL=http://127.0.0.1:3000
BOT_API_SECRET=

# VK publishing (organizer-only integration)
VK_GROUP_ID=
VK_ACCESS_TOKEN=
VK_API_VERSION=5.199
