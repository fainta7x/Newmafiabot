# Server configuration
PORT=3000
NODE_ENV=development

# Organizer Authentication
ORGANIZER_PASSWORD=admin
JWT_SECRET=super-secret-jwt-key-change-this-in-production
# Optional dedicated secret for the stable OBS Browser Source URL. When empty,
# the URL is derived from JWT_SECRET and changes if JWT_SECRET is rotated.
LIVE_BROADCAST_SECRET=

# SQLite Database path
DATABASE_PATH=./mafia_club.db
SEED_DEMO_DATA=false

# Telegram bot token used by webhook/bot runtime and durable direct-message outbox.
TELEGRAM_BOT_TOKEN=
USE_WEBHOOK=false
WEBHOOK_URL=
# Explicit organizer notification audience. Prefer ORGANIZER_NOTIFICATION_IDS
# for one or more comma-separated private Telegram chat IDs. ORGANIZER_CHAT_ID
# remains a legacy explicit single-recipient fallback. ADMIN_IDS is never used
# automatically for organizer digests.
ORGANIZER_NOTIFICATION_IDS=
ORGANIZER_CHAT_ID=
# BACKUP_ADMIN_ID is used for organizer notifications only when this opt-in is true.
ORGANIZER_NOTIFICATION_USE_BACKUP=false
BACKUP_ADMIN_ID=
ORGANIZER_NOTIFICATION_INTERVAL_MINUTES=30
# Optional concurrency for durable direct-message delivery (server clamps to 1..10; default 4).
TELEGRAM_OUTBOX_CONCURRENCY=4
# Integration settings
BOT_API_BASE_URL=http://127.0.0.1:3000
BOT_API_SECRET=
BOT_SERVICE_URL=http://127.0.0.1:8081
# Public HTTPS origin used by Telegram/VK Player Cabinet action links and betting notifications.
PLAYER_APP_URL=

# VK publishing, Player Cabinet identity and personal messaging for 2LA Noire.
# Non-secret club references are built into the adapter and may be overridden here if VK IDs/URLs change.
VK_GROUP_ID=212761164
VK_GROUP_SCREEN_NAME=2lanoiremafia
VK_GROUP_URL=https://vk.ru/2lanoiremafia
VK_CHANNEL_URL=https://vk.ru/im/channels/-233806277
# Reserved for a future official VK Channels API peer id. The public
# /im/channels URL suffix cannot currently be used for automatic publishing.
VK_CHANNEL_API_PEER_ID=
# VK ID application registered for the WebApp / Player Cabinet OAuth flow.
VK_APP_ID=54719021
# Optional legacy user-token override. New VK ID tokens are authentication-only and cannot publish posts.
VK_ACCESS_TOKEN=
# Community token from «Управление → Работа с API». Kept server-side only.
# Used for public community publishing and personal `messages.send` delivery to users
# who have allowed messages from the community.
VK_GROUP_ACCESS_TOKEN=
VK_API_VERSION=5.199
# Configure the same secret in VK community Callback API settings.
VK_CALLBACK_SECRET=
# Confirmation string is issued by VK for the community. Public + channel currently use the same community ID.
VK_CALLBACK_CONFIRMATION=
VK_CHANNEL_CALLBACK_CONFIRMATION=