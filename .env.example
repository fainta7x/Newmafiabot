# Server configuration
PORT=3000
NODE_ENV=development

# Organizer Authentication
ORGANIZER_PASSWORD=admin
JWT_SECRET=super-secret-jwt-key-change-this-in-production

# SQLite Database path
DATABASE_PATH=./mafia_club.db
SEED_DEMO_DATA=false

# Legacy Telegram Bot Token (Must be revoked in BotFather if previously leaked)
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_URL=
ORGANIZER_CHAT_ID=
# Integration settings
BOT_API_BASE_URL=http://127.0.0.1:3000
BOT_API_SECRET=

# VK publishing and poll sync.
# VK_ACCESS_TOKEN must be a user token with rights to create polls and publish to the configured community wall.
VK_GROUP_ID=
VK_ACCESS_TOKEN=
VK_API_VERSION=5.199
# Optional second community wall. Use this only when the VK channel is addressable as a community/group wall.
VK_CHANNEL_GROUP_ID=
VK_CHANNEL_URL=
# Configure the same secret in every VK community Callback API setup.
VK_CALLBACK_SECRET=
# Confirmation string is issued by VK separately for each community.
VK_CALLBACK_CONFIRMATION=
VK_CHANNEL_CALLBACK_CONFIRMATION=
