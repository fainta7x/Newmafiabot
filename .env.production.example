NODE_ENV=production
HOST=0.0.0.0
PORT=3000

# Canonical Amvera production storage is the persistent /data volume.
# deploy/start-web.sh hard-pins DATABASE_PATH to this same location and unsets
# any stale TURSO_DATABASE_URL / TURSO_AUTH_TOKEN variables before Node starts.
DATABASE_PATH=/data/mafia_crm.sqlite
DATABASE_BOOTSTRAP_FROM_CHECKPOINT=true
SEED_DEMO_DATA=false

# Legacy/recovery only. Do not set these in the canonical Amvera deployment
# unless a separate, explicit storage migration is being performed.
# TURSO_DATABASE_URL=
# TURSO_AUTH_TOKEN=

ORGANIZER_PASSWORD=<set-a-strong-password>
JWT_SECRET=<set-a-random-secret-at-least-32-characters>
# Optional but recommended when the OBS URL should survive JWT secret rotation.
LIVE_BROADCAST_SECRET=<set-a-random-secret-at-least-32-characters>
BOT_API_SECRET=<set-a-random-secret-at-least-32-characters>
TELEGRAM_BOT_TOKEN=<set-in-amvera-secret>
USE_WEBHOOK=true
WEBHOOK_URL=https://2la-noire-chagina7x.waw0.amvera.tech
# Explicit organizer digest audience; ADMIN_IDS is not reused automatically.
ORGANIZER_NOTIFICATION_IDS=<comma-separated-private-chat-ids>
# Legacy explicit fallback when ORGANIZER_NOTIFICATION_IDS is empty.
ORGANIZER_CHAT_ID=<set-if-used>
# Optional and disabled by default: permit BACKUP_ADMIN_ID as the digest fallback.
ORGANIZER_NOTIFICATION_USE_BACKUP=false
BACKUP_ADMIN_ID=<set-if-used-for-backup-admin>
TELEGRAM_OUTBOX_CONCURRENCY=4
# Public Mini App origin used in personal/betting Telegram messages.
PLAYER_APP_URL=https://2la-noire-chagina7x.waw0.amvera.tech
BOT_API_BASE_URL=https://2la-noire-chagina7x.waw0.amvera.tech
BOT_SERVICE_URL=http://127.0.0.1:8081
