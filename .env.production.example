NODE_ENV=production
HOST=0.0.0.0
PORT=3000

# Current production-primary storage. Configure BOTH values together.
TURSO_DATABASE_URL=<set-in-render-secret>
TURSO_AUTH_TOKEN=<set-in-render-secret>

# Local SQLite fallback only. On Render Free this path is ephemeral and is not
# the production source of truth while Turso credentials are configured.
DATABASE_PATH=/tmp/2la-noire-web-staging/mafia_crm.sqlite
DATABASE_BOOTSTRAP_FROM_CHECKPOINT=true
SEED_DEMO_DATA=false

ORGANIZER_PASSWORD=<set-a-strong-password>
JWT_SECRET=<set-a-random-secret-at-least-32-characters>
# Optional but recommended when the OBS URL should survive JWT secret rotation.
LIVE_BROADCAST_SECRET=<set-a-random-secret-at-least-32-characters>
BOT_API_SECRET=<set-a-random-secret-at-least-32-characters>
TELEGRAM_BOT_TOKEN=<set-in-render-secret>
TELEGRAM_WEBHOOK_URL=<set-if-used>
ORGANIZER_CHAT_ID=<set-if-used>
BOT_API_BASE_URL=<set-service-url>
