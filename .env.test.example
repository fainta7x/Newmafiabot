# Separate Amvera application for test.tournoir
NODE_ENV=production
APP_ENV=test
HOST=0.0.0.0
PORT=3000

# deploy/start-web.sh pins this to /data/mafia_crm.test.sqlite.
# Do not add TURSO_* variables and do not reuse a production /data volume.
DATABASE_PATH=/data/mafia_crm.test.sqlite
DATABASE_BOOTSTRAP_FROM_CHECKPOINT=false
SEED_DEMO_DATA=true

TEST_ACCESS_PASSWORD=<set-a-strong-password-at-least-12-characters>
ORGANIZER_PASSWORD=<set-a-separate-test-organizer-password>
JWT_SECRET=<set-a-separate-random-secret-at-least-32-characters>
BOT_API_SECRET=<set-a-separate-random-secret-at-least-32-characters>

# External delivery is deliberately absent in the test application.
TELEGRAM_BOT_TOKEN=
USE_WEBHOOK=false
WEBHOOK_URL=
PLAYER_APP_URL=https://test.tournoir
BOT_API_BASE_URL=https://test.tournoir
BOT_SERVICE_URL=http://127.0.0.1:8081
VK_ACCESS_TOKEN=
VK_GROUP_ACCESS_TOKEN=
VK_CALLBACK_SECRET=
