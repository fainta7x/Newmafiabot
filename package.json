{
  "name": "mafia-crm-dashboard",
  "version": "1.0.0",
  "description": "A fully-featured fullstack CRM and Game scoring dashboard for the Mafia Club",
  "main": "server.ts",
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "build": "vite build && esbuild server.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=dist/server.cjs",
    "start": "node dist/server.cjs"
  },
  "dependencies": {
    "canvas-confetti": "^1.9.3",
    "express": "^4.19.2",
    "lucide-react": "^0.395.0",
    "motion": "^11.2.10",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "recharts": "^2.12.7"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.2",
    "@types/canvas-confetti": "^1.6.4",
    "@types/express": "^4.17.21",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "autoprefixer": "^10.4.19",
    "esbuild": "^0.21.5",
    "postcss": "^8.4.38",
    "tailwindcss": "^4.0.0-alpha.18",
    "tsx": "^4.15.6",
    "typescript": "^5.4.5",
    "vite": "^5.2.11"
  }
}
