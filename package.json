{
  "name": "mafia-crm-dashboard",
  "version": "1.0.0",
  "description": "A fully-featured fullstack CRM and Game scoring dashboard for the Mafia Club",
  "main": "server.ts",
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "build": "vite build && esbuild server.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=dist/server.cjs",
    "start": "node dist/server.cjs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint \"src/**/*.{ts,tsx}\" server.ts vite.config.ts --max-warnings=0",
    "test": "vitest run",
    "test:integration": "vitest run",
    "release:audit": "tsx src/scripts/releaseAudit.ts",
    "project:status": "tsx src/scripts/projectContext.ts",
    "project:find": "tsx src/scripts/projectNavigate.ts",
    "project:affected": "tsx src/scripts/projectAffected.ts",
    "project:verify": "npm run release:audit && npm run typecheck && npm run lint && npm test && npm run build",
    "migrate:legacy": "tsx src/db/migrateLegacyData.ts",
    "restore:tournament-bogdana": "tsx scripts/restoreTournamentBogdana.ts",
    "checkpoint:preview-db": "tsx src/scripts/createCheckpoint.ts",
    "checkpoint:git-db": "tsx src/scripts/createGitCheckpoint.ts",
    "checkpoint:git-export": "tsx src/scripts/createGitCheckpoint.ts",
    "checkpoint:git-import": "tsx src/scripts/importGitCheckpoint.ts",
    "db:legacy-player-link-dry-run": "tsx src/scripts/legacyPlayerLinkDryRun.ts"
  },
  "dependencies": {
    "@google/genai": "^2.14.0",
    "bcryptjs": "^3.0.3",
    "better-sqlite3": "^13.0.1",
    "canvas-confetti": "^1.9.3",
    "cookie-parser": "^1.4.7",
    "dotenv": "^17.4.2",
    "drizzle-orm": "^0.45.2",
    "express": "^5.2.1",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "lucide-react": "^0.532.0",
    "motion": "^11.2.10",
    "multer": "^2.2.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "recharts": "^2.12.7",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/react": "^16.3.2",
    "@types/bcryptjs": "^3.0.0",
    "@types/better-sqlite3": "^7.6.13",
    "@types/canvas-confetti": "^1.6.4",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.6",
    "@types/helmet": "^4.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^2.2.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@types/supertest": "^7.2.1",
    "@typescript-eslint/eslint-plugin": "^8.65.0",
    "@typescript-eslint/parser": "^8.65.0",
    "@vitejs/plugin-react": "^4.3.1",
    "esbuild": "^0.21.5",
    "eslint": "^10.8.0",
    "jsdom": "^30.0.1",
    "supertest": "^7.2.2",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.15.6",
    "typescript": "^6.0.3",
    "vite": "^5.2.11",
    "vitest": "^4.1.10"
  }
}
